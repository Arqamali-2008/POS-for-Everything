# AMi POS v2.0.0 - Environment Configuration
# Copy this file to .env.local for development or .env for production
# 
# 🔑 IMPORTANT: All cloud credentials below are OPTIONAL!
# By default, the system runs 100% OFFLINE using local SQLite database.
# Only add cloud credentials if you want multi-device sync or cloud backup.

# ============================================================================
# DATABASE PROVIDER (Choose ONE)
# ============================================================================
# Options: sqlite | supabase | turso | azuresql
# Default: sqlite (fully offline, no cloud required)
DB_PROVIDER=sqlite

# ============================================================================
# SQLITE (Local Development - DEFAULT, works offline)
# ============================================================================
SQLITE_DB_PATH=./data/pos.db

# ============================================================================
# SUPABASE (PostgreSQL Cloud) - OPTIONAL
# ============================================================================
# Only needed if DB_PROVIDER=supabase
# Get these from your Supabase project settings
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_KEY=your-service-role-key

# ============================================================================
# TURSO (LibSQL Cloud) - OPTIONAL
# ============================================================================
# Only needed if DB_PROVIDER=turso
# Get these from your Turso database settings
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your-auth-token
# TURSO_SYNC_URL=

# ============================================================================
# AZURE SQL DATABASE - OPTIONAL
# ============================================================================
# Only needed if DB_PROVIDER=azuresql
# AZURE_SQL_SERVER=your-server.database.windows.net
# AZURE_SQL_DATABASE=posdb
# AZURE_SQL_USER=your-user
# AZURE_SQL_PASSWORD=your-password
# AZURE_SQL_ENCRYPT=true
# AZURE_SQL_TRUST_SERVER_CERT=false

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================================================
# AUTHENTICATION
# ============================================================================
# JWT_SECRET is OPTIONAL in development (auto-generated)
# Required in production - generate with: openssl rand -base64 32
# JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-in-production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Local admin fallback (works without any cloud config)
LOCAL_ADMIN_EMAIL=admin@pos.com
LOCAL_ADMIN_PASSWORD=admin123

# Session settings
SESSION_TIMEOUT_MS=900000
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MS=900000

# ============================================================================
# SYNC CONFIGURATION
# ============================================================================
SYNC_ENABLED=false
SYNC_INTERVAL_MS=30000
SYNC_BATCH_SIZE=100
SYNC_MAX_RETRIES=3
SYNC_RETRY_DELAY_MS=5000
SYNC_CONFLICT_RESOLUTION=last_write_wins

# ============================================================================
# FEATURE FLAGS
# ============================================================================
FEATURE_MULTI_BRANCH=false
FEATURE_LOYALTY=false
FEATURE_CREDIT_SALES=true
FEATURE_PURCHASES=true
FEATURE_EXPENSES=true
FEATURE_CHEQUES=true
FEATURE_LOANS=true
FEATURE_INVENTORY_ADJUSTMENTS=true
FEATURE_DAILY_RECONCILIATION=true
FEATURE_HELD_BILLS=true
FEATURE_BARCODE_SCANNING=true
FEATURE_VOICE_COMMANDS=false
FEATURE_QR_BACKUP=true
FEATURE_PRINT_QUEUE=true
FEATURE_REALTIME_SYNC=true

# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================================
# REQUEST LIMITS
# ============================================================================
BODY_SIZE_LIMIT=50mb
REQUEST_TIMEOUT_MS=30000

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=debug

# ============================================================================
# WEBSOCKET
# ============================================================================
WS_PORT=3001