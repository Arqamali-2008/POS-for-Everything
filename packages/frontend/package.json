{
  "name": "@pospro/frontend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test:local": "esbuild src/services/localStorageClient.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/ami-pos-localClient.mjs && node scripts/smoke-local.mjs",
    "clean": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('node_modules/.vite',{recursive:true,force:true})\""
  },
  "dependencies": {
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.24.0",
    "@tanstack/react-query": "^5.40.0",
    "zustand": "^4.5.0",
    "axios": "^1.7.0",
    "socket.io-client": "^4.7.0",
    "date-fns": "^3.6.0",
    "zod": "^3.23.0",
    "react-hook-form": "^7.52.0",
    "@hookform/resolvers": "^3.6.0",
    "lucide-react": "^0.395.0",
    "clsx": "^2.1.0",
    "tailwind-merge": "^2.3.0",
    "idb": "^8.0.0",
    "qrcode.react": "^3.1.0",
    "@zxing/library": "^0.21.0",
    "@zxing/browser": "^0.1.0",
    "jsbarcode": "^3.11.0",
    "xlsx": "^0.18.5",
    "file-saver": "^2.0.5",
    "@pospro/core": "file:../core"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/file-saver": "^2.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "tailwindcss": "^3.4.0",
    "postcss": "^8.4.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.0.0",
    "@types/node": "^24.0.0"
  }
}
