# Frontend Environment Configuration
# Copy to .env.local for development

# Data mode:
#   local = all data is saved in the browser's localStorage (default, no DB needed)
#   api   = use the Node.js backend (set VITE_API_URL as well)
VITE_DATA_MODE=local

# API Backend URL (only used when VITE_DATA_MODE=api)
VITE_API_URL=http://localhost:3000/api

# WebSocket URL (defaults to same host)
VITE_WS_URL=

# App Configuration
VITE_APP_NAME=AMi POS
VITE_APP_VERSION=2.0.0

# Feature Flags (override backend settings if needed)
# VITE_FEATURE_BARCODE_SCANNING=true
# VITE_FEATURE_VOICE_COMMANDS=false
# VITE_FEATURE_QR_BACKUP=true

# Theme
# VITE_DEFAULT_THEME=system
