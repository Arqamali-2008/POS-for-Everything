{
  "name": "@pospro/core",
  "version": "2.0.0",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas/database.d.ts",
      "import": "./dist/schemas/database.js",
      "require": "./dist/schemas/database.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "zod": "^3.23.0",
    "drizzle-orm": "^0.32.0",
    "drizzle-zod": "^0.5.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^24.0.0"
  }
}